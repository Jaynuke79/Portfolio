{
  "extends": "./tsconfig.json",
  "include": [
    "client/src/**/*",
    "scripts/**/*.ts",
    "apps-script/**/*.test.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "vite.config.github.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "docs", ".archive"],
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "target": "ES2022",
    "allowJs": true
  }
}
